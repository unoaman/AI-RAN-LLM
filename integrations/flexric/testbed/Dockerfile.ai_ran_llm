# ran-xapp + ran-lab-drive (the HandoverLLM side of the testbed). Build context: repository root.
FROM python:3.11-slim
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch && \
    pip install --no-cache-dir "numpy>=1.24"
WORKDIR /app
COPY pyproject.toml README.md ./
COPY ai_ran_llm ai_ran_llm
COPY checkpoints/handover_llm.pt checkpoints/handover_llm.pt
COPY integrations/flexric/cells.example.json integrations/flexric/cells.example.json
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "-m", "ai_ran_llm"]
